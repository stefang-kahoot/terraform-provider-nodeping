# NodePing Terraform Provider Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Required: Your NodePing API token
# Get this from Account Settings in the NodePing web interface
NODEPING_API_TOKEN=your-api-token-here

# Optional: Default SubAccount customer ID
# Use this to manage resources in a SubAccount by default
# NODEPING_CUSTOMER_ID=201203232048C76FH

# Optional: API URL (for testing/development only)
# NODEPING_API_URL=https://api.nodeping.com/api/1

# Optional: the acceptance tests against the real NodePing API (TestAccLive*).
# They write to the account: use only a dedicated test SubAccount's token and
# its customer ID. See CONTRIBUTING.md.
# NODEPING_API_TOKEN_ACCEPTANCE_TESTS=your-test-subaccount-token-here
# NODEPING_ACCEPTANCE_TESTS_CUSTOMER_ID=201203232048C76FH
